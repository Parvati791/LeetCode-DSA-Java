import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int a = sc.nextInt();
        int b = sc.nextInt();
        int c = sc.nextInt();

        int highest = a;

        if (b > highest) {
            highest = b;
        }

        if (c > highest) {
            highest = c;
        }

        System.out.println("Highest mark: " + highest);

        sc.close();
    }
}
