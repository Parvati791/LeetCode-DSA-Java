import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        int visits = 0;
        for (int i = 0; i < n; i++) {
            visits++;
        }

        int pairs = 0;
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                pairs++;
            }
        }

        System.out.println("Visits: " + visits);
        System.out.println("Pairs: " + pairs);

        sc.close();
    }
}
